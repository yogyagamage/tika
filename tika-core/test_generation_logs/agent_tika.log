package org.apache.tika.config;

import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.osgi.framework.BundleContext;
import org.osgi.framework.ServiceReference;
import org.osgi.util.tracker.ServiceTracker;

import java.util.Dictionary;
import java.util.Hashtable;

public class TikaActivatorstart_ServiceTrackeropenFikaTest {

    @Test
    public void testStart() throws Exception {
        BundleContext mockBundleContext = Mockito.mock(BundleContext.class);
        
        ServiceReference<?> mockDetectorRef = Mockito.mock(ServiceReference.class);
        ServiceReference<?> mockParserRef = Mockito.mock(ServiceReference.class);
        
        Mockito.when(mockBundleContext.getServiceReference(Mockito.anyString()))
               .thenReturn(mockDetectorRef, mockParserRef);
        
        Dictionary<String, Object> properties = new Hashtable<>();
        Mockito.when(mockDetectorRef.getProperties()).thenReturn(properties);
        Mockito.when(mockParserRef.getProperties()).thenReturn(properties);
        
        TikaActivator activator = new TikaActivator();
        activator.start(mockBundleContext);
    }
}

