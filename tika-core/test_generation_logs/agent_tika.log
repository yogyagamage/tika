import java.io.ByteArrayOutputStream;
import java.io.InputStream;
import java.io.OutputStream;

public class ExternalEmbedderembed_IOUtilscopyFikaTest {

    @Test
    public void testEmbedCallsIOUtilsCopy() throws Exception {
        // Create a minimal ExternalEmbedder instance
        ExternalEmbedder embedder = new ExternalEmbedder();
        
        // Configure command to use output file token (to trigger the IOUtils.copy path)
        String[] command = new String[]{"echo", ExternalParser.OUTPUT_FILE_TOKEN};
